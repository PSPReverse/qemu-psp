# psp-smn.c
psp_smn_read(uint64_t off, uint64_t phys, uint64_t value, uint64_t size) "offset=0x%"PRIx64" phys=0x%"PRIx64" value=0x%"PRIx64" size=0x%"PRIx64
psp_smn_write(uint64_t off, uint64_t phys, uint64_t value, uint64_t size) "offset=0x%"PRIx64" phys=0x%"PRIx64" value=0x%"PRIx64" size=0x%"PRIx64
psp_smn_update_slot(uint32_t idx, uint64_t addr) "slot=0x%"PRIx32" addr=0x%"PRIx64

# psp-smn-misc.c
psp_smn_misc_read(uint64_t off, uint64_t val) "offset=0x%"PRIx64" value=0x%"PRIx64
psp_smn_misc_read_unimplemented(uint64_t off) "offset=0x%"PRIx64" value=0x0 (default)"
psp_smn_misc_read_override(uint64_t off, uint64_t val) "offset=0x%"PRIx64" value=0x%"PRIx64
psp_smn_misc_write(uint64_t off, uint64_t val) "offset=0x%"PRIx64" value=0x%"PRIx64
psp_smn_misc_write_unimplemented(uint64_t off, uint64_t val) "offset=0x%"PRIx64" value=0x%"PRIx64

# psp-smn-smbus.c
psp_smn_smbus_read(uint64_t off, uint8_t val) "offset=0x%"PRIx64" value=0x%02x"
psp_smn_smbus_write(uint64_t off, uint8_t val) "offset=0x%"PRIx64" value=0x%02x"
psp_smn_smbus_xfer(unsigned addr7, bool read, unsigned proto, uint8_t cmd, bool ack) "addr7=0x%02x read=%d proto=%u cmd=0x%02x ack=%d"
