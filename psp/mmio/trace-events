# psp-sts.c
psp_sts_write(uint64_t value, char const * in_x86_space) "value=0x%"PRIx64" is_x86_space=%s"
psp_sts_read(uint64_t value, char const * in_x86_space) "value=0x%"PRIx64" is_x86_space=%s"

# psp-timer.c
psp_timer_control_write(uint64_t off, uint64_t value) "offset=0x%"PRIx64" value=0x%"PRIx64
psp_timer_control_read(uint64_t off, uint64_t value) "offset=0x%"PRIx64" value=0x%"PRIx64
psp_timer_counter_write(uint64_t value) "value=0x%"PRIx64
psp_timer_counter_read(uint64_t value) "value=0x%"PRIx64

# psp-fuse.c
psp_fuse_read(uint64_t off, uint64_t value, unsigned int size) "offset=0x%"PRIx64" value=0x%"PRIx64" size=0x%x"
psp_fuse_write(uint64_t off, uint64_t value, unsigned int size) "offset=0x%"PRIx64" value=0x%"PRIx64" size=0x%x"

# mailbox.c
psp_mailbox_write(const char *target, uint32_t value) "target=%s, value=0x%"PRIx32
psp_mailbox_ctrl_write(uint32_t value) "0x0301069c write value=0x%"PRIx32
psp_mailbox_ctrl_read(uint32_t value) "0x0301069c read value=0x%"PRIx32
psp_mailbox_read(const char *target, uint32_t value) "target=%s, value=0x%"PRIx32
